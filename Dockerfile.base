# Shared image for the API and the worker (Railway builds this with a
# different start command per service). Python 3.12, Tesseract with Hebrew.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    NTK_CONTRACTS_DIR=/app/contracts
RUN apt-get update && apt-get install -y --no-install-recommends \
      tesseract-ocr tesseract-ocr-heb tesseract-ocr-eng libgl1 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN pip install -r requirements.lock
COPY contracts /app/contracts
COPY db /app/db
COPY manifests /app/manifests
COPY golden /app/golden
COPY services /app/services
COPY adapters /app/adapters
RUN pip install --no-deps -e services/common -e adapters/project315 -e services/api -e services/worker
RUN useradd --create-home --uid 10001 ntk && chown -R ntk /app
USER ntk
EXPOSE 8000
CMD ["uvicorn", "ntk_api.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
