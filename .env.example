# ---- names only; never commit real values -------------------------------
NTK_ENV=development                 # development | test | production
NTK_LOG_LEVEL=INFO
NTK_PUBLIC_BASE_URL=                # public URL of the API, e.g. https://api.example.org
NTK_CITATION_PERMALINK_BASE=        # optional: WordPress citation URL base, e.g. https://site.example/trial/source/
NTK_ANSWER_PERMALINK_BASE=          # optional: WordPress answer URL base
NTK_CASE_ID=il-jdc-jerusalem-67104-01-20
NTK_COURT_CASE_NUMBER=67104-01-20

# PostgreSQL 16 with pgvector + pg_trgm (Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=
NTK_EMBEDDING_DIM=3072              # deployment parameter; >2000 needs pgvector >= 0.7 (halfvec)

# Redis (task queue, rate limits, nonces)
REDIS_URL=

# Object storage: Cloudflare R2 (S3 API)
NTK_STORAGE_BACKEND=s3              # s3 | local (tests only)
S3_ENDPOINT_URL=                    # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=             # endpoint browsers use for presigned URLs (normally same as above)
S3_REGION=auto
S3_BUCKET=
S3_PREFIX=sources/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL_SECONDS=900
NTK_MAX_UPLOAD_BYTES=209715200

# Models (no model names are hard-coded; ADR-0007)
NTK_MODEL_PROVIDER=mock             # mock | gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NTK_MODEL_EXTRACTOR=                # high-recall candidate extraction (Lite allowed)
NTK_MODEL_MAPPER=                   # claim/evidence mapping (not Lite)
NTK_MODEL_JUDICIAL_CLASSIFIER=      # final judicial classification (never Lite)
NTK_MODEL_WRITER=                   # answers (not Lite)
NTK_MODEL_QA_RELATION=
NTK_MODEL_VERIFIER=                 # final verification (never Lite); prefer another family
NTK_VERIFIER_PROVIDER=              # empty = same as NTK_MODEL_PROVIDER → sensitive items always go to human review
NTK_VERIFIER_API_KEY=
NTK_VERIFIER_BASE_URL=
NTK_EMBEDDING_PROVIDER=mock         # mock | gemini
NTK_EMBEDDING_MODEL=
NTK_EMBEDDING_API_KEY=
NTK_MODEL_TEMPERATURE=0
NTK_MODEL_TIMEOUT_SECONDS=120
NTK_MODEL_MAX_RETRIES=3

# Service accounts for admin calls (JSON): {"wp-prod": {"secret": "...", "scopes": ["admin:all"]}}
NTK_SERVICE_KEYS=
NTK_SIGNATURE_MAX_SKEW_SECONDS=300
NTK_IP_HASH_SALT=

# CORS (comma list of WordPress origins) and limits
NTK_CORS_ORIGINS=
NTK_RATE_LIMIT_ASK_PER_MINUTE=6
NTK_RATE_LIMIT_SEARCH_PER_MINUTE=30
NTK_RATE_LIMIT_PUBLIC_PER_MINUTE=120
NTK_MAX_QUESTION_CHARS=500
NTK_MAX_BODY_BYTES=65536

# WordPress cache-purge webhook
WP_CALLBACK_URL=                    # https://site.example/wp-json/trial-knowledge/v1/webhook
WP_CALLBACK_SECRET=

# Pipeline
NTK_OCR_ENABLED=true
NTK_OCR_LANGS=heb+eng
NTK_FETCH_ALLOWLIST=www.gov.il,gov.il
